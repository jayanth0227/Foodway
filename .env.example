# ==========================================
# Foodway Combined Environment Configuration
# ==========================================

# -----------------
# Server Settings
# -----------------
PORT=5000

# -----------------
# Client Settings (VITE_ prefixed = browser-visible, safe to expose)
# -----------------
VITE_API_BASE_URL=http://localhost:5000/api
# VITE_API_BASE_URL=https://YOUR_API_GATEWAY_URL.execute-api.REGION.amazonaws.com/prod/api
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_GOOGLE_MAP_KEY=your_google_maps_key
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# -----------------
# AWS Settings (Server-side only — NOT needed in Lambda, use IAM role instead)
# -----------------
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_REGION=ap-south-2
AWS_S3_BUCKET_NAME=your_s3_bucket_name
AWS_DYNAMODB_REGION=ap-south-2
AWS_DYNAMODB_TABLE_NAME=mk-delivery-services
AWS_DYNAMODB_USERS_TABLE_NAME=foodway-users

# -----------------
# Admin Credentials (Server-side only)
# -----------------
ADMIN_EMAIL=admin@foodway.com
ADMIN_PASSWORD=your_admin_password

# -----------------
# SMTP Credentials (Server-side only)
# -----------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM=your_smtp_email@gmail.com

# -----------------
# JWT (Server-side only)
# -----------------
JWT_SECRET=your_jwt_secret_key

# -----------------
# CORS (Server-side — comma-separated allowed origins)
# -----------------
CLIENT_URL=http://localhost:5173
